{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zoo-downloader",
  "version": "0.1.0",
  "identifier": "com.zoo.zoo-downloader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:10020",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zoo Downloader",
        "width": 1600,
        "height": 900,
        "minWidth": 600,
        "minHeight": 400,
        "center": true,
        "closable": true,
        "minimizable": true,
        "maximizable": true,
        "decorations": true,
        "transparent": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "tooltip": "Zoo Downloader"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "marketplace/zoo-marketplace.json": "marketplace/zoo-marketplace.json",
      "marketplace/k2s/manifest.json": "marketplace/k2s/manifest.json",
      "marketplace/k2s/dist/index.js": "marketplace/k2s/dist/index.js"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
