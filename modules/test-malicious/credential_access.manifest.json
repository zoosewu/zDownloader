{
  "id": "credential-access-test",
  "name": "Credential Access Test Module",
  "version": "1.0.0",
  "description": "Security test: Attempts to access raw credential values",
  "urlPatterns": [
    "https://test.example.com/*"
  ],
  "permissions": {
    "network": {
      "allowDomains": ["test.example.com"]
    },
    "credentials": {
      "required": true,
      "credentialKeys": ["username", "password", "apiKey"]
    }
  }
}
