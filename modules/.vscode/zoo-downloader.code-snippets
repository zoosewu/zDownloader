{
  "Zoo Downloader Module": {
    "prefix": "zoo-module",
    "description": "Complete Zoo Downloader site module template",
    "body": [
      "/// <reference types=\"zoo-downloader\" />",
      "",
      "/**",
      " * @typedef {import('zoo-downloader').ModuleContext} ModuleContext",
      " * @typedef {import('zoo-downloader').DownloadInfo} DownloadInfo",
      " */",
      "",
      "/**",
      " * ${1:ModuleName} site module",
      " * @implements {import('zoo-downloader').SiteModule}",
      " */",
      "export class ${1:ModuleName}Module {",
      "  constructor() {",
      "    this.session = null;",
      "  }",
      "",
      "  /**",
      "   * Check if this module can handle the URL",
      "   * @param {string} url",
      "   * @returns {boolean}",
      "   */",
      "  canHandle(url) {",
      "    return url.includes('${2:example.com}');",
      "  }",
      "",
      "  /**",
      "   * Extract download information",
      "   * @param {string} url",
      "   * @param {ModuleContext} context",
      "   * @returns {Promise<DownloadInfo>}",
      "   */",
      "  async extractDownloadInfo(url, context) {",
      "    try {",
      "      // Fetch page",
      "      const response = await context.http.get(url);",
      "      ",
      "      // Parse download URL",
      "      const downloadUrl = this.parseDownloadUrl(response.body);",
      "      if (!downloadUrl) {",
      "        throw new Error('Failed to parse download URL');",
      "      }",
      "",
      "      return {",
      "        downloadUrl,",
      "        filename: this.parseFilename(response.body),",
      "        filesize: null,",
      "        headers: { 'Referer': url }",
      "      };",
      "    } catch (error) {",
      "      throw new Error(`Extraction failed: \\${error.message}`);",
      "    }",
      "  }",
      "",
      "  /**",
      "   * Parse download URL from HTML",
      "   * @param {string} html",
      "   * @returns {string|null}",
      "   */",
      "  parseDownloadUrl(html) {",
      "    ${3:// TODO: Implement parsing logic}",
      "    return null;",
      "  }",
      "",
      "  /**",
      "   * Parse filename from HTML",
      "   * @param {string} html",
      "   * @returns {string}",
      "   */",
      "  parseFilename(html) {",
      "    ${4:// TODO: Implement parsing logic}",
      "    return 'download';",
      "  }",
      "}",
      "",
      "export default ${1:ModuleName}Module;",
      "$0"
    ]
  },
  "HTTP GET Request": {
    "prefix": "zoo-http-get",
    "description": "HTTP GET request with error handling",
    "body": [
      "const response = await context.http.get('${1:url}', {",
      "  headers: {",
      "    '${2:Referer}': '${3:value}'",
      "  }",
      "});",
      "",
      "if (response.status !== 200) {",
      "  throw new Error(`HTTP ${response.status}: ${4:Failed to fetch}`);",
      "}",
      "",
      "${0:// Process response.body}"
    ]
  },
  "HTTP POST Request": {
    "prefix": "zoo-http-post",
    "description": "HTTP POST request with JSON body",
    "body": [
      "const response = await context.http.post('${1:url}', {",
      "  body: JSON.stringify({",
      "    ${2:key}: '${3:value}'",
      "  }),",
      "  headers: {",
      "    'Content-Type': 'application/json'",
      "  }",
      "});",
      "",
      "if (response.status !== 200) {",
      "  throw new Error(`HTTP ${response.status}: ${4:Request failed}`);",
      "}",
      "",
      "${0:// Process response}"
    ]
  },
  "CAPTCHA Request": {
    "prefix": "zoo-captcha",
    "description": "Request CAPTCHA solution from user",
    "body": [
      "// Check if CAPTCHA is needed",
      "if (${1:needsCaptcha}(response.body)) {",
      "  const solution = await context.captcha.request({",
      "    type: '${2|image,recaptcha,hcaptcha|}',",
      "    ${3:imageUrl}: '${4:captchaUrl}'",
      "  });",
      "  ",
      "  // Use solution",
      "  ${0:const userInput = solution.solution;}",
      "}"
    ]
  },
  "Login Flow": {
    "prefix": "zoo-login",
    "description": "Login flow with credentials check",
    "body": [
      "/**",
      " * Login to the site",
      " * @param {ModuleContext} context",
      " */",
      "async login(context) {",
      "  if (this.session) {",
      "    return; // Already logged in",
      "  }",
      "",
      "  if (!context.credentials) {",
      "    throw new Error('Credentials required but not provided');",
      "  }",
      "",
      "  const response = await context.http.post('${1:loginUrl}', {",
      "    body: JSON.stringify({",
      "      username: context.credentials.username,",
      "      password: context.credentials.password",
      "    }),",
      "    headers: {",
      "      'Content-Type': 'application/json'",
      "    }",
      "  });",
      "",
      "  if (response.status !== 200) {",
      "    throw new Error('Login failed');",
      "  }",
      "",
      "  this.session = response.cookies.session;",
      "  context.log.info('Login successful');",
      "  ${0}",
      "}"
    ]
  },
  "Parse Helper": {
    "prefix": "zoo-parse",
    "description": "HTML parsing helper function",
    "body": [
      "/**",
      " * Parse ${1:data} from HTML",
      " * @param {string} html",
      " * @returns {${2:string}|null}",
      " */",
      "parse${1/(.*)/${1:/capitalize}/}(html) {",
      "  const match = html.match(/${3:pattern}/);",
      "  if (!match) {",
      "    return null;",
      "  }",
      "  return match[${4:1}];",
      "  ${0}",
      "}"
    ]
  },
  "Error Handling": {
    "prefix": "zoo-error",
    "description": "Comprehensive error handling",
    "body": [
      "try {",
      "  ${1:// Main logic}",
      "} catch (error) {",
      "  context.log.error('${2:Operation} failed:', error);",
      "  ",
      "  // Provide user-friendly error message",
      "  if (error.message.includes('domain not allowed')) {",
      "    throw new Error('Permission denied: Cannot access this domain');",
      "  } else if (error.message.includes('timeout')) {",
      "    throw new Error('Request timeout. Please try again.');",
      "  } else {",
      "    throw new Error(`${2:Operation} failed: \\${error.message}`);",
      "  }",
      "}",
      "$0"
    ]
  },
  "Logging": {
    "prefix": "zoo-log",
    "description": "Logging statement",
    "body": [
      "context.log.${1|info,warn,error|}('${2:message}', ${3:data});",
      "$0"
    ]
  },
  "Return Download Info": {
    "prefix": "zoo-return",
    "description": "Return download information",
    "body": [
      "return {",
      "  downloadUrl: ${1:downloadUrl},",
      "  filename: ${2:filename},",
      "  filesize: ${3:null},",
      "  headers: {",
      "    'Referer': ${4:url}",
      "  },",
      "  metadata: {",
      "    downloadHints: {",
      "      chunkSize: ${5:1024 * 1024 * 20}, // 20 MB",
      "      maxConnections: ${6:10},",
      "      requestDelay: ${7:0}",
      "    }",
      "  }",
      "};",
      "$0"
    ]
  }
}
