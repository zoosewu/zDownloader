# Example environment configuration
# Copy this file to .env.development or .env.production

# Development mode flag (true for Docker/browser development, false for native Tauri)
VITE_DEV_MODE=true

# Tauri HTTP Bridge URL (only used when VITE_DEV_MODE=true)
# Change this if you're running the backend on a different host/port
VITE_TAURI_HTTP_URL=http://localhost:3030
