{
  "name": "zoo-downloader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build:module-host-js": "esbuild src-tauri/crates/zoo-module/js/vendor.js --bundle --format=iife --minify --platform=neutral --main-fields=module,main --target=es2022 --legal-comments=eof --banner:js=\"/* Generated by pnpm build:module-host-js from crates/zoo-module/js/vendor.js. Bundles core-js (MIT) and linkedom (ISC) with their dependencies; licenses in their packages. */\" --outfile=src-tauri/crates/zoo-module/src/gen/vendor.js",
    "dev": "vite --host --mode development",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "./scripts/run-tauri-dev.sh",
    "build:win": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc",
    "build:debug": "tauri build --debug --runner cargo-xwin --target x86_64-pc-windows-msvc"
  },
  "dependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^6.0.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "i18next": "^23.0.0",
    "jotai": "^2.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^14.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/ui": "^4.0.15",
    "core-js": "^3.51.0",
    "esbuild": "^0.28.2",
    "jsdom": "^27.2.0",
    "linkedom": "^0.18.15",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.0.15"
  }
}
